      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PSQL_NUSPACE"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(\n  AVG(EXTRACT(EPOCH FROM (first_sg.sent_at - t.created_at)) / 3600.0)::numeric,\n  2\n)::double precision AS value\nFROM tickets t\nJOIN LATERAL (\n  SELECT m.sent_at\n  FROM conversations c\n  JOIN messages m ON m.conversation_id = c.id\n  WHERE c.ticket_id = t.id AND m.is_from_sg_member\n  ORDER BY m.sent_at\n  LIMIT 1\n) first_sg ON TRUE\nWHERE t.created_at >= NOW() - INTERVAL '90 days';",
          "refId": "A"
        }
      ],
      "title": "Avg hours to first SG reply",
      "type": "stat"
    },
