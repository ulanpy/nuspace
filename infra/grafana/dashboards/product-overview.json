          "rawQuery": true,
          "rawSql": "SELECT ROUND(\n  AVG(EXTRACT(EPOCH FROM (t.updated_at - t.created_at)) / 3600.0)::numeric,\n  2\n)::double precision AS value\nFROM tickets t\nWHERE t.status::text IN ('resolved', 'closed')\n  AND t.updated_at >= NOW() - INTERVAL '90 days';",
