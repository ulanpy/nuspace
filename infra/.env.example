# Developer's Private Keys
TELEGRAM_BOT_TOKEN= # get from BotFather in telegram
# Dev/ops chat (negative id for supergroups). Used by Grafana alerts and as
# SG Otinish fallback when sg_ministries.telegram_chat_id is NULL.
TELEGRAM_CHAT_ID=

# Database connection
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=postgres
DB_PORT=5432


# Redis connection
REDIS_HOST=redis
REDIS_PORT=6379


# Meeilisearch connection
MEILISEARCH_URL = "http://meilisearch:7700"
MEILISEARCH_MASTER_KEY = "secret"


# Keycloak Client information
REALM=secret 
KEYCLOAK_CLIENT_ID=secret
KEYCLOAK_CLIENT_SECRET=secret
KEYCLOAK_URL=secret

# Google Bucket 
BUCKET_NAME=secret
BACKUPS_BUCKET_NAME=nuspace-backups-staging
GCP_PROJECT_ID=secret
GCP_TOPIC_ID=secret
PUSH_AUTH_SERVICE_ACCOUNT=secret
PUSH_AUTH_AUDIENCE=secret
# Pre-parsed schedule catalog (Cloud Run Job → GCS → FastAPI → Meilisearch)
SCHEDULE_SYNC_GCS_OBJECT=registrar/course_schedule_catalog.json

# FastApi specific
SESSION_MIDDLEWARE_KEY=secret
TG_WEBHOOK_SECRET_TOKEN=secret
APP_JWT_SECRET_256=secret
APP_TOKEN_EXPIRY_MINUTES=5
GCS_EMULATOR_HOST="http://gcs:4443" # this is a container adress
DEV_APP_URL=http://localhost  # browser/OAuth origin in debug (not used for webhooks)
MOCK_KEYCLOAK=True   # true unless you are have necessary keys for services
USE_GCS_EMULATOR=True # true unless you are have necessary keys for services
IS_DEBUG=True  # local: uvicorn --reload; prod compose sets IS_DEBUG=false (no reload, single process)
# OpenTelemetry (OTLP → Alloy → Tempo). Set OTEL_EXPORTER_OTLP_ENDPOINT= to disable.
OTEL_SERVICE_NAME=fastapi
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
# Per-process full-trace budgets. Each bucket starts full and refills at this rate.
OTEL_TRACE_NORMAL_MAX_PER_SECOND=10
OTEL_TRACE_CRITICAL_MAX_PER_SECOND=10
# Gemini (/post event extraction)
# Local (IS_DEBUG=true): uses Developer API — set GEMINI_API_KEY from Google AI Studio.
# Prod (IS_DEBUG=false): uses enterprise mode + VM service account (ADC); key not required.
# Override explicitly with GEMINI_USE_ENTERPRISE=true|false if needed.
GEMINI_API_KEY=secret
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_LOCATION=global

# PgAdmin credentials
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=123


# RMQ and Celery containers
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq://
CELERY_RESULT_BACKEND=redis://redis:6379/0


# Main Domain
NUSPACE=https://nuspace.kz

#WG-easy creds
WG_EASY_PASSWORD=secret

# Grafana credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
# SELECT-only Postgres role for Grafana product panels (created by grafana-db-init on compose up)
GRAFANA_DB_USER=admin
GRAFANA_DB_PASSWORD=admin
VM_SERVICE_ACCOUNT_EMAIL=admin@admin

#Qualtrics credentials
QUALTRICS_API_TOKEN=secret
QUALTRICS_DATA_CENTER_ID=secret
QUALTRICS_SURVEY_ID=secret
